<?xml version="1.0" encoding="utf-8"?>
<!--
    Privacy: this app is local-only and intentionally declares no INTERNET permission, so the app
    itself can't send anything it handles (transactions, receipt photos, OCR text). Only Android's own
    backup and phone-to-phone transfer take its data off the device (see <application>).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Some libraries declare network permissions: ML Kit's usage logging (datatransport) adds
        INTERNET and CameraX's media3 dependency adds ACCESS_NETWORK_STATE. They are removed here so
        the privacy guarantee above holds; OCR and Gemini Nano work without them.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!-- Receipt scanning with our own camera screen. Devices without a camera can still use the app. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!--
        Daily reminder and planned transactions: the notifications, and setting their alarms again
        after a reboot.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
        Exact timing for both (decision D10). From Android 14 the user has to allow it; without it the
        alarms stay inexact. Not USE_EXACT_ALARM, which Play keeps for alarm-clock and calendar apps.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!--
        Backup: the user's Google backup (only when encrypted end to end) and phone-to-phone transfer
        carry the database, receipt photos and settings (decision D2). Rules for Android 12+ in
        data_extraction_rules.xml, for Android 8-11 in backup_rules.xml.
    -->
    <application
        android:name=".LadgerApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ladger"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Share" a receipt photo or PDF from another app, like the iOS share extension (one file only). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <!-- Add transaction and Scan when the app icon is long-pressed, like the iOS quick actions. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <receiver
            android:name=".reminder.ReminderReceiver"
            android:exported="false" />
        <receiver
            android:name=".reminder.PlannedTransactionReceiver"
            android:exported="false" />
        <!-- Home screen widgets (decision D4), as iOS's: month chart, budget, latest transactions. -->
        <receiver
            android:name=".widget.MonthChartWidgetReceiver"
            android:exported="true"
            android:label="@string/this_month_balance">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_month_chart" />
        </receiver>
        <receiver
            android:name=".widget.BudgetWidgetReceiver"
            android:exported="true"
            android:label="@string/budgeting">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_budget" />
        </receiver>
        <receiver
            android:name=".widget.RecentTransactionsWidgetReceiver"
            android:exported="true"
            android:label="@string/transactions">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_recent_transactions" />
        </receiver>
        <receiver
            android:name=".widget.WidgetMonthReceiver"
            android:exported="false" />
        <receiver
            android:name=".reminder.ReminderRescheduleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
